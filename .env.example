# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Model used for extraction
INVOICE_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max (leave empty for the model default)
INVOICE_EFFORT=medium
# Server-side refusal fallbacks (on/off). Only used for models that support them.
INVOICE_FALLBACKS=on
